{
  "name": "library-api",
  "author": "Paulo Silva",
  "version": "1.0.0",
  "description": "REST API for managing library books and loans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "none"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "imports": {
    "#controllers/*": "./src/controllers/*.js",
    "#routes/*": "./src/routes/*.js",
    "#config/*": "./src/config/*.js",
    "#services/*": "./src/services/*.js",
    "#repositories/*": "./src/repositories/*.js",
    "#database": "./src/database/index.js",
    "#schemas/*": "./src/schemas/*.js",
    "#middlewares/*": "./src/middlewares/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/server.js",
    "db:setup": "node src/scripts/db_setup.js",
    "db:seed": "node src/scripts/db_seed.js",
    "token": "node src/scripts/gen_token.js",
    "test": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --silent --verbose"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
